    "agent_feedback_event": {
      "description": "JSONL-safe progress event emitted while a Slack agent run executes.",
      "properties": {
        "event_type": {
          "title": "Event Type",
          "type": "string"
        },
        "payload": {
          "additionalProperties": true,
          "title": "Payload",
          "type": "object"
        },
        "schema": {
          "default": "keystone.slack.agent_feedback_event.v1",
          "title": "Schema",
          "type": "string"
        }
      },
      "required": [
        "event_type"
      ],
      "title": "SlackAgentFeedbackEvent",
      "type": "object"
    },
    "business_agent_action": {
      "description": "JSON value carried by first-class business-agent Slack buttons.",
      "properties": {
        "approval_id": {
          "default": "",
          "title": "Approval Id",
          "type": "string"
        },
        "artifact_id": {
          "default": "",
          "title": "Artifact Id",
          "type": "string"
        },
        "gate_scope": {
          "default": "",
          "title": "Gate Scope",
          "type": "string"
        },
        "intent": {
          "title": "Intent",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
