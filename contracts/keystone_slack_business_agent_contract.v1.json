  "version": "1",
  "write_gate": {
    "action_id": "kba_approve_write_request",
    "intent": "approve_agent_write_request",
    "no_send_text": "This approval only lets the AI agent run this request. It does not allow sending email, posting externally, publishing, scheduling, or creating live drafts unless a later specific gate allows it."
  }
