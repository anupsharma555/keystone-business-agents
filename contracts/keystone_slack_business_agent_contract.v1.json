              "default": "",
              "title": "Ts",
              "type": "string"
            },
            "user_id": {
              "default": "",
              "title": "User Id",
              "type": "string"
            },
            "username": {
              "default": "",
              "title": "Username",
              "type": "string"
            }
          },
          "title": "SlackContextMessage",
          "type": "object"
        }
      },
      "description": "Local-only context captured from a selected Slack message or thread.",
      "properties": {
        "channel_id": {
          "default": "",
          "title": "Channel Id",
          "type": "string"
        },
        "channel_name": {
          "default": "",
          "title": "Channel Name",
          "type": "string"
        },
        "eval": {
          "additionalProperties": true,
          "title": "Eval",
          "type": "object"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "permalink": {
          "default": "",
          "title": "Permalink",
          "type": "string"
        },
        "prior_agent_runs": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Prior Agent Runs",
          "type": "array"
        },
        "schema": {
          "const": "keystone.slack.selected_message_context.v1",
          "default": "keystone.slack.selected_message_context.v1",
          "title": "Schema",
          "type": "string"
        },
        "selected_message": {
          "$ref": "#/$defs/SlackContextMessage"
        },
        "selected_message_ts": {
          "default": "",
          "title": "Selected Message Ts",
          "type": "string"
        },
        "source": {
          "default": "slack_message_action",
          "title": "Source",
          "type": "string"
        },
        "team_domain": {
          "default": "",
          "title": "Team Domain",
          "type": "string"
        },
        "team_id": {
          "default": "",
          "title": "Team Id",
          "type": "string"
        },
        "thread_fetch_status": {
          "default": "not_requested",
          "enum": [
            "ok",
            "failed",
            "not_requested"
          ],
          "title": "Thread Fetch Status",
          "type": "string"
        },
        "thread_messages": {
          "items": {
            "$ref": "#/$defs/SlackContextMessage"
          },
          "title": "Thread Messages",
          "type": "array"
        },
        "thread_ts": {
          "default": "",
          "title": "Thread Ts",
          "type": "string"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "title": "SlackSelectedMessageContext",
      "type": "object"
    },
