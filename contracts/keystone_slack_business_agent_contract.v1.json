          "type": "string"
        },
        "source_message_ts": {
          "default": "",
          "title": "Source Message Ts",
          "type": "string"
        },
        "source_thread_ts": {
          "default": "",
          "title": "Source Thread Ts",
          "type": "string"
        },
        "work_item_id": {
          "default": "",
          "title": "Work Item Id",
          "type": "string"
        }
      },
      "required": [
        "intent"
      ],
      "title": "BusinessAgentActionPayload",
      "type": "object"
    },
    "operator_failure": {
      "description": "Shared operator-readable failure shape embedded in Slack feedback and results.",
      "properties": {
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "next_step": {
          "title": "Next Step",
