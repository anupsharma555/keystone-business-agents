# Copy to .env for local runs. Keep real secrets out of Git.
# This file is placeholder-only and should never contain live credentials.
# Fill only the blocks for functionality you plan to use.

# 1. Safety defaults. Keep these conservative unless you are running a live command.
KEYSTONE_LIVE_MODE=false
KEYSTONE_DRY_RUN=true
KEYSTONE_ENABLE_LIVE_GMAIL=false
KEYSTONE_ENABLE_LIVE_SLACK=false
KEYSTONE_ENABLE_LIVE_RESEARCH=false
KEYSTONE_ENABLE_LIVE_CRM=false
KEYSTONE_PLAYWRIGHT_ENABLED=false
KEYSTONE_PLAYWRIGHT_IMAGE_DIR=artifacts/playwright-images

# 2. OpenAI Agents SDK model execution.
# Agent construction and fixture tests do not require an OpenAI key.
# Keystone intentionally ignores generic OPENAI_API_KEY, OPENAI_MODEL, and
# OPENAI_BASE_URL shell variables so other projects can use them.
MODEL_PROVIDER=openai
KEYSTONE_OPENAI_MODEL=gpt-5.4-mini
KEYSTONE_OPENAI_API_KEY=
KEYSTONE_OPENAI_BASE_URL=
KEYSTONE_LIVE_MODEL_TIMEOUT_SECONDS=120
KEYSTONE_LIVE_MODEL_MAX_RETRIES=1
# Optional external OpenAI-compatible gateway URL. Gemini is available only as
# an explicit agent/provider override; set this only to route through LiteLLM or
# another reviewed gateway. Do not install the Python litellm package into this
# repo's venv for gateway mode.
LITELLM_BASE_URL=
GEMINI_API_KEY=
KEYSTONE_ENABLE_GEMINI_FALLBACK=false
KEYSTONE_GEMINI_FALLBACK_MODEL=gemini-2.5-flash
KEYSTONE_GEMINI_FALLBACK_BASE_URL=
KEYSTONE_AGENT_RUN_BUDGET_USD=0.25

# 2a. Runtime-agent model routing.
# Leave provider/model blank to use the agent-specific defaults below.
# Main operating agents default to OpenAI gpt-5.4-mini during integration
# testing. Gemini remains available through explicit per-agent provider/model
# overrides. Agent base URLs are optional and only needed for reviewed gateways.
KEYSTONE_ORCHESTRATOR_MODEL_PROVIDER=openai
KEYSTONE_ORCHESTRATOR_MODEL=gpt-5.4-mini
KEYSTONE_ORCHESTRATOR_BASE_URL=
KEYSTONE_GMAIL_TRIAGE_MODEL_PROVIDER=openai
KEYSTONE_GMAIL_TRIAGE_MODEL=gpt-5.4-mini
KEYSTONE_GMAIL_TRIAGE_BASE_URL=
KEYSTONE_BUSINESS_RESEARCH_ANALYST_MODEL_PROVIDER=openai
KEYSTONE_BUSINESS_RESEARCH_ANALYST_MODEL=gpt-5.4-mini
KEYSTONE_BUSINESS_RESEARCH_ANALYST_BASE_URL=
KEYSTONE_OPPORTUNITY_SCOUT_MODEL_PROVIDER=openai
KEYSTONE_OPPORTUNITY_SCOUT_MODEL=gpt-5.4-mini
KEYSTONE_OPPORTUNITY_SCOUT_BASE_URL=
KEYSTONE_OUTREACH_COMPOSER_MODEL_PROVIDER=openai
KEYSTONE_OUTREACH_COMPOSER_MODEL=gpt-5.4-mini
KEYSTONE_OUTREACH_COMPOSER_BASE_URL=
KEYSTONE_CHIEF_OF_STAFF_MODEL_PROVIDER=openai
KEYSTONE_CHIEF_OF_STAFF_MODEL=gpt-5.4-mini
KEYSTONE_CHIEF_OF_STAFF_BASE_URL=

# 3. Local SQLite audit/artifact store.
DATABASE_URL=sqlite:///keystone_agents.db

# 3a. Optional WorkItem orchestration.
# Requires installing this repo with the `orchestration` extra. The SDK agents,
# SQLite WorkItems, safety gates, and approval boundaries remain canonical.
KEYSTONE_WORKITEM_LANGGRAPH=false

# 4. Optional SDK tracing metadata. Keep sensitive data excluded.
KEYSTONE_TRACE_WORKFLOW_NAME=Keystone live SDK run
KEYSTONE_TRACE_GROUP_ID=
KEYSTONE_TRACE_METADATA=
KEYSTONE_TRACING_DISABLED=true
KEYSTONE_TRACE_INCLUDE_SENSITIVE_DATA=false

# 5. Gmail inbound triage and draft creation.
# Default is disabled and dry-run tests do not need these files.
# Put local OAuth files at the paths below. They are ignored by Git.
# Do not paste OAuth JSON, access tokens, or refresh tokens into .env.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json
KEYSTONE_GMAIL_DRAFT_ACCOUNT=operator@example.com

# 6. Slack approval notifications.
SLACK_BOT_TOKEN=
SLACK_CHANNEL_APPROVALS=

# 6a. Optional @KNI Slack business-agent bridge.
# These are primarily consumed by the local keystone-slack Socket Mode runtime.
# Keep live search, live Slack posting, and Gmail draft creation independent.
KNI_BUSINESS_AGENTS_SLACK_CONTEXT_ENABLED=false
KNI_BUSINESS_AGENTS_BACKGROUND_RUNS=false
KNI_BUSINESS_AGENTS_APPROVALS_ENABLED=true
KNI_BUSINESS_AGENTS_MESSAGE_ACTIONS_ENABLED=true
KNI_BUSINESS_AGENTS_HISTORY_CONTEXT_ENABLED=false
KNI_BUSINESS_AGENTS_LANGGRAPH=false
KNI_BUSINESS_AGENTS_LIVE_SDK=false
KNI_BUSINESS_AGENTS_LIVE_SEARCH=false
KNI_BUSINESS_AGENTS_LIVE_SLACK=false
KNI_BUSINESS_AGENTS_LIVE_GMAIL_DRAFTS=false
# Promptfoo/eval review Slack channel, mirrored by the Slack bridge.
KNI_BUSINESS_AGENTS_EVAL_CHANNEL=C0BA17Y9C01
KNI_BUSINESS_AGENTS_APPROVAL_CHANNEL=

# 7. Company/opportunity research search providers.
# Primary search lanes are SearXNG, Agents SDK hosted web search, Exa, and
# Tavily. Serper is disabled while API credits are unavailable.
# Default live research uses SearXNG plus capped Agents hosted web-search and
# optional Exa/Tavily deepening lanes when enabled.
# Tests use fixtures and mocks; no search provider key or base URL is required.
SEARCH_PROVIDER=dry-run
KEYSTONE_COMPANY_SEARCH_CONCURRENCY=4
KEYSTONE_OPPORTUNITY_SEARCH_CONCURRENCY=4
KEYSTONE_OPPORTUNITY_RETRIEVAL_DEADLINE_SECONDS=90
# Follow-up/adaptive Opportunity Scout search queries default to the hard cap of 8
# results per query. Lower this to conserve provider credits.
KEYSTONE_OPPORTUNITY_FOLLOWUP_RESULT_CAP=8
# Manual Opportunity Scout calls can run an optional pre-retrieval LLM planner
# through the CLI/Slack bridge. Other manual agent calls can also run a shared
# manual-request planner before routing/execution. If unavailable, all planners
# fall back to local structured heuristics.
# New live natural-language asks default to the dedicated audited OpenAI planner.
# Set target or target_with_openai_fallback only for controlled provider experiments.
KEYSTONE_MANUAL_PLANNER_MODEL_PROVIDER=openai
KEYSTONE_MANUAL_PLANNER_MODEL=gpt-5.4-mini
KEYSTONE_MANUAL_PLANNER_BASE_URL=
KEYSTONE_MANUAL_PLANNER_PROVIDER_POLICY=openai
SERPER_API_KEY=
KEYSTONE_SERPER_ENABLED=false
# Repo-local SearXNG runtime: scripts/manage_searxng_headless.sh start
SEARXNG_BASE_URL=http://127.0.0.1:18080
SEARXNG_API_KEY=
# For one-off Slack/CLI live-search runs, start repo-local SearXNG only when
# needed and stop it afterward if this process started it.
KEYSTONE_SEARXNG_TRANSIENT=true
EXA_API_KEY=
EXA_BASE_URL=https://api.exa.ai
EXA_SERVICE_API_KEY=
EXA_API_KEY_ID=
EXA_API_KEY_NAME=default
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=https://api.firecrawl.dev
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com
TAVILY_MCP_LINK=
# Free-plan friendly default. `advanced` costs more credits.
TAVILY_SEARCH_DEPTH=basic
# Tavily Search credits: basic/fast/ultra-fast = 1 credit/request; advanced = 2.
# The free plan currently provides 1,000 credits/month. The default policy tracks
# usage and warns near the soft limit; set enforcement to `block` for a hard cap.
KEYSTONE_TAVILY_MONTHLY_CREDIT_LIMIT=1000
KEYSTONE_TAVILY_MONTHLY_SOFT_LIMIT=850
KEYSTONE_TAVILY_CREDIT_ENFORCEMENT=warn
KEYSTONE_TAVILY_USAGE_PATH=
# Use Tavily only as a capped quality-gap/formal-research deepening lane.
KEYSTONE_TAVILY_SEARCH_FALLBACK=true
KEYSTONE_TAVILY_SEARCH_MAX_CALLS_PER_RUN=2
# Exa free-tier allowance is 20,000 requests/month. Keep each run capped.
KEYSTONE_EXA_MONTHLY_FREE_REQUEST_LIMIT=20000
KEYSTONE_EXA_SEARCH_FALLBACK=true
KEYSTONE_EXA_SEARCH_MAX_CALLS_PER_RUN=10
KEYSTONE_AGENTS_WEB_SEARCH_FALLBACK=true
KEYSTONE_AGENTS_WEB_SEARCH_PARALLEL=true
KEYSTONE_AGENTS_WEB_SEARCH_MAX_CALLS_PER_RUN=2

# Optional hosted FileSearch corpus retrieval for approved durable reference docs.
# Leave blank unless a reviewed corpus has been uploaded to an OpenAI vector store.
# Agent-specific env values override the global value and the local JSON config.
# For the public OpenAI Agents Python SDK corpus, prefer setting the three
# agent-specific vector store variables below, or use
# .local/file-search-vector-stores.json, rather than the global variable.
KEYSTONE_FILE_SEARCH_CONFIG_PATH=.local/file-search-vector-stores.json
KEYSTONE_FILE_SEARCH_VECTOR_STORE_IDS=
KEYSTONE_FILE_SEARCH_MAX_NUM_RESULTS=
KEYSTONE_FILE_SEARCH_INCLUDE_RESULTS=false
KEYSTONE_BUSINESS_RESEARCH_ANALYST_FILE_SEARCH_VECTOR_STORE_IDS=
KEYSTONE_BUSINESS_RESEARCH_ANALYST_FILE_SEARCH_MAX_NUM_RESULTS=
KEYSTONE_BUSINESS_RESEARCH_ANALYST_FILE_SEARCH_INCLUDE_RESULTS=false
KEYSTONE_CHIEF_OF_STAFF_FILE_SEARCH_VECTOR_STORE_IDS=
KEYSTONE_CHIEF_OF_STAFF_FILE_SEARCH_MAX_NUM_RESULTS=
KEYSTONE_CHIEF_OF_STAFF_FILE_SEARCH_INCLUDE_RESULTS=false
KEYSTONE_ORCHESTRATOR_FILE_SEARCH_VECTOR_STORE_IDS=
KEYSTONE_ORCHESTRATOR_FILE_SEARCH_MAX_NUM_RESULTS=
KEYSTONE_ORCHESTRATOR_FILE_SEARCH_INCLUDE_RESULTS=false

# Optional local-source KNI document search for Chief of Staff.
# Reuses the keystone-slack `/kni-doc` SQLite index in read-only mode. Content
# is filtered before entering model context. When model-context access is true,
# guarded snippets and capped/redacted reads may be sent to the configured live
# model provider; external send/post/share actions remain disabled.
KEYSTONE_KNI_DOC_SEARCH_ENABLED=true
KEYSTONE_KNI_DOC_ROOT_PATH=/path/to/approved/keystone-documents
KEYSTONE_KNI_DOC_INDEX_PATH=/path/to/keystone-slack/.local/kni-docs.sqlite
KEYSTONE_KNI_DOC_PDF_TEXT_COMMAND=pdftotext
KEYSTONE_KNI_DOC_CONTENT_SCAN_MODE=block
KEYSTONE_KNI_DOC_MODEL_CONTEXT_ALLOWED=true
KEYSTONE_KNI_DOC_AUTO_REFRESH=true
KEYSTONE_KNI_DOC_REFRESH_TIMEOUT_SECONDS=90

# Optional stage-three search review. Auto-execution is off by default to avoid
# unexpected hosted web_search token spend; scheduled/Slack runs can opt in.
KEYSTONE_SANDBOX_SEARCH_REVIEW_AUTO_EXECUTE=false
KEYSTONE_SANDBOX_SEARCH_REVIEW_LIVE=false
KEYSTONE_SANDBOX_SEARCH_REVIEW_SOURCE_LIMIT=8
KEYSTONE_SANDBOX_SEARCH_REVIEW_WEB_SEARCH_CONTEXT=low

# 8. Optional scraping/enrichment providers.
# Trafilatura is local/free and is the default website extractor.
# With no fallback override, shallow or failed Trafilatura reads may use the
# local Crawl4AI adapter. Set the ordered fallback list to crawl4ai,firecrawl
# only when capped paid Firecrawl extraction is explicitly intended.
KEYSTONE_ENABLE_WEBSITE_EXTRACTION=false
KEYSTONE_WEBSITE_EXTRACTOR=trafilatura
KEYSTONE_WEBSITE_EXTRACTOR_FALLBACK=
KEYSTONE_FIRECRAWL_EXTRACTION_MAX_CALLS_PER_RUN=4
KEYSTONE_WEBSITE_EXTRACTION_MAX_PAGES=8
KEYSTONE_AGENT_HTML_REVIEW=false
KEYSTONE_AGENT_HTML_REVIEW_MAX_PAGES=2
KEYSTONE_AGENT_HTML_REVIEW_MAX_CHARS=8000
KEYSTONE_AGENT_HTML_REVIEW_MIN_CLAIMS=1
KEYSTONE_ENABLE_SOURCE_API_ENRICHMENT=false
APIFY_API_TOKEN=
BROWSERLESS_API_KEY=

# Optional local context sources. Leave blank unless you intentionally enable
# private local folder lookup for your own machine. Do not commit real paths.
KEYSTONE_NEUROINFORMATICS_DIR=
KEYSTONE_ZOTERO_ACTIVE_DIR=
KEYSTONE_ZOTERO_APP_SUPPORT_DIR=
KEYSTONE_ZOTERO_REFERENCE_ARCHIVE_DIR=
KEYSTONE_ZOTERO_IMPORT_CACHE=
KEYSTONE_ZOTERO_ALLOW_TEST_NOTE_WRITES=false
KEYSTONE_ZOTERO_ALLOW_TEST_LIBRARY_WRITES=false
KEYSTONE_PRESENTATION_LIBRARY_ROOT=
KEYSTONE_PRESENTATION_LIVE_READS=false
KEYSTONE_PRESENTATION_ALLOW_DERIVED_WRITES=false
KEYSTONE_PRESENTATION_DERIVED_ROOT=artifacts/presentation-derived
KEYSTONE_LOCAL_CONTEXT_SOURCES_JSON=
KEYSTONE_LOCAL_CONTEXT_SOURCES=

# Optional shared local config source. Business Agents can read allowlisted
# read-only context integration settings from the sibling keystone-slack .env.
KEYSTONE_CONTEXT_CONFIG_REPO=
# Optional read-only Keystone discovery history used by Preprints Context.
DISCOVERY_STORE_PATH=
# Explicit read-only Slack fallback for RSS Context; never posts or modifies messages.
KEYSTONE_RSS_CONTEXT_LIVE_SLACK_READ_ENABLED=false
# Test-only exact-ID cleanup for drafts marked KBA_TEST_DRAFT in subject and body.
KEYSTONE_GMAIL_ALLOW_TEST_DRAFT_DELETES=false
KEYSTONE_GMAIL_ALLOW_MAILBOX_WRITES=false
KEYSTONE_GMAIL_ALLOW_DRAFT_ATTACHMENTS=false
KEYSTONE_GMAIL_DRAFT_ATTACHMENT_RECIPIENT=reviewer@example.com
KEYSTONE_GMAIL_ALLOW_TEST_SENDS=false
KEYSTONE_GMAIL_TEST_SEND_RECIPIENT=reviewer@example.com
KEYSTONE_GMAIL_TEST_SEND_MAX=0
KEYSTONE_SLACK_ALLOW_TEST_MESSAGE_WRITES=false
KEYSTONE_SLACK_TEST_CHANNEL=
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_TIMEZONE=America/New_York
KEYSTONE_GOOGLE_CALENDAR_ALLOW_WRITES=false
KEYSTONE_GOOGLE_WORKSPACE_ALLOW_TEST_LIFECYCLE=false
KEYSTONE_CONTEXT_CONFIG_OVERRIDE=false
KEYSTONE_CONTEXT_CONFIG_OVERRIDE_KEYS=

# 9. Optional external table mirrors and CRM context imports.
# Live Airtable and Google Sheets mirroring are placeholders and require explicit live flags.
AIRTABLE_API_KEY=
AIRTABLE_ACCESS_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_BASE_NAME=2026 Finance & Tax Tracker
AIRTABLE_ALLOWED_TABLES=Business Income,Business Expenses,Personal Income,Personal Expenses,Tax Payments
AIRTABLE_DEFAULT_TABLE=
AIRTABLE_DEFAULT_VIEW=
AIRTABLE_ALLOW_WRITES=false
AIRTABLE_ALLOW_TEST_DELETES=false
AIRTABLE_ALLOW_DUPLICATE_CLEANUP=false
AIRTABLE_WRITE_DRY_RUN=true
AIRTABLE_ALLOW_ATTACHMENT_UPLOADS=false
AIRTABLE_REQUEST_TIMEOUT_SECONDS=20
AIRTABLE_READ_ALL_MAX_RECORDS=5000
AIRTABLE_FINANCE_TAX_TRACKER_BASE_ID=
AIRTABLE_FINANCE_TAX_TRACKER_ACCESS_TOKEN=
AIRTABLE_FINANCE_TAX_TRACKER_BASE_NAME=2026 Finance & Tax Tracker
AIRTABLE_FINANCE_TAX_TRACKER_DEFAULT_TABLE=
AIRTABLE_FINANCE_TAX_TRACKER_DEFAULT_VIEW=
AIRTABLE_FINANCE_TAX_TRACKER_ALLOWED_TABLES=Business Income,Business Expenses,Personal Income,Personal Expenses,Tax Payments
AIRTABLE_KNI_OPS_BASE_ID=
AIRTABLE_KNI_OPS_BASE_NAME=KNI Ops
AIRTABLE_KNI_OPS_DEFAULT_TABLE=
AIRTABLE_KNI_OPS_DEFAULT_VIEW=
AIRTABLE_KNI_OPS_ALLOWED_TABLES=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_SHEETS_SPREADSHEET_ID=
