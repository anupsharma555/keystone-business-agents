# Copy to .env for local runs. Keep real secrets out of Git.
# Fill only the blocks for functionality you plan to use.

# 1. Safety defaults. Keep these conservative unless you are running a live command.
KEYSTONE_LIVE_MODE=false
KEYSTONE_DRY_RUN=true
KEYSTONE_ENABLE_LIVE_GMAIL=false
KEYSTONE_ENABLE_LIVE_SLACK=false
KEYSTONE_ENABLE_LIVE_RESEARCH=false
KEYSTONE_ENABLE_LIVE_CRM=false

# 2. OpenAI Agents SDK model execution.
# Agent construction and fixture tests do not require an OpenAI key.
# Keystone intentionally ignores generic OPENAI_API_KEY, OPENAI_MODEL, and
# OPENAI_BASE_URL shell variables so other projects can use them.
MODEL_PROVIDER=openai
KEYSTONE_OPENAI_MODEL=gpt-5.4-mini
KEYSTONE_OPENAI_API_KEY=
KEYSTONE_OPENAI_BASE_URL=
# Optional external OpenAI-compatible gateway URL. Gemini defaults to Google's
# direct OpenAI-compatible endpoint; set this only to route through LiteLLM or
# another reviewed gateway. Do not install the Python litellm package into this
# repo's venv for gateway mode.
LITELLM_BASE_URL=
GEMINI_API_KEY=
KEYSTONE_AGENT_RUN_BUDGET_USD=0.25

# 2a. Runtime-agent model routing.
# Leave provider/model blank to use the agent-specific defaults below.
# Orchestrator defaults to OpenAI gpt-5.4-mini for hybrid LLM/deterministic review.
# Business Research Analyst and Opportunity Scout default to OpenAI gpt-5.4-mini.
# Gmail Triage and Outreach Composer default to Gemini direct when GEMINI_API_KEY
# is set. Agent base URLs are optional and only needed for reviewed gateways.
KEYSTONE_ORCHESTRATOR_MODEL_PROVIDER=openai
KEYSTONE_ORCHESTRATOR_MODEL=gpt-5.4-mini
KEYSTONE_ORCHESTRATOR_BASE_URL=
KEYSTONE_GMAIL_TRIAGE_MODEL_PROVIDER=
KEYSTONE_GMAIL_TRIAGE_MODEL=
KEYSTONE_GMAIL_TRIAGE_BASE_URL=
KEYSTONE_BUSINESS_RESEARCH_ANALYST_MODEL_PROVIDER=openai
KEYSTONE_BUSINESS_RESEARCH_ANALYST_MODEL=gpt-5.4-mini
KEYSTONE_BUSINESS_RESEARCH_ANALYST_BASE_URL=
KEYSTONE_OPPORTUNITY_SCOUT_MODEL_PROVIDER=openai
KEYSTONE_OPPORTUNITY_SCOUT_MODEL=gpt-5.4-mini
KEYSTONE_OPPORTUNITY_SCOUT_BASE_URL=
KEYSTONE_OUTREACH_COMPOSER_MODEL_PROVIDER=gemini
KEYSTONE_OUTREACH_COMPOSER_MODEL=gemini-2.5-flash
KEYSTONE_OUTREACH_COMPOSER_BASE_URL=

# 3. Local SQLite audit/artifact store.
DATABASE_URL=sqlite:///keystone_agents.db

# 4. Optional SDK tracing metadata. Keep sensitive data excluded.
KEYSTONE_TRACE_WORKFLOW_NAME=Keystone live SDK run
KEYSTONE_TRACE_GROUP_ID=
KEYSTONE_TRACE_METADATA=
KEYSTONE_TRACING_DISABLED=true
KEYSTONE_TRACE_INCLUDE_SENSITIVE_DATA=false

# 5. Gmail inbound triage and draft creation.
# Default is disabled and dry-run tests do not need these files.
# Put local OAuth files at the paths below. They are ignored by Git.
# Do not paste OAuth JSON, access tokens, or refresh tokens into .env.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json

# 6. Slack approval notifications.
SLACK_BOT_TOKEN=
SLACK_CHANNEL_APPROVALS=

# 7. Company/opportunity research search providers.
# SearXNG, Serper, and Firecrawl search are wired behind explicit live flags.
# Tests use fixtures and mocks; no search provider key or base URL is required.
SEARCH_PROVIDER=dry-run
KEYSTONE_COMPANY_SEARCH_CONCURRENCY=4
KEYSTONE_OPPORTUNITY_SEARCH_CONCURRENCY=4
# Follow-up/adaptive Opportunity Scout search queries default to the hard cap of 8
# results per query. Lower this to conserve provider credits.
KEYSTONE_OPPORTUNITY_FOLLOWUP_RESULT_CAP=8
# Manual Opportunity Scout calls can run an optional pre-retrieval LLM planner
# through the CLI/Slack bridge. Other manual agent calls can also run a shared
# manual-request planner before routing/execution. If unavailable, all planners
# fall back to local structured heuristics.
KEYSTONE_MANUAL_PLANNER_PROVIDER_POLICY=target_with_openai_fallback
SERPER_API_KEY=
SEARXNG_BASE_URL=http://127.0.0.1:8080
SEARXNG_API_KEY=
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=https://api.firecrawl.dev

# Optional stage-three search review. Auto-execution is off by default to avoid
# unexpected hosted web_search token spend; scheduled/Slack runs can opt in.
KEYSTONE_SANDBOX_SEARCH_REVIEW_AUTO_EXECUTE=false
KEYSTONE_SANDBOX_SEARCH_REVIEW_LIVE=false
KEYSTONE_SANDBOX_SEARCH_REVIEW_SOURCE_LIMIT=8
KEYSTONE_SANDBOX_SEARCH_REVIEW_WEB_SEARCH_CONTEXT=low

# 8. Optional scraping/enrichment providers.
# Trafilatura is local/free and is the default website extractor.
# Set KEYSTONE_WEBSITE_EXTRACTOR=firecrawl to use Firecrawl Cloud or a self-hosted
# Firecrawl endpoint. Firecrawl is open source, but the hosted API needs a key.
KEYSTONE_ENABLE_WEBSITE_EXTRACTION=false
KEYSTONE_WEBSITE_EXTRACTOR=trafilatura
KEYSTONE_WEBSITE_EXTRACTOR_FALLBACK=
KEYSTONE_ENABLE_SOURCE_API_ENRICHMENT=false
APIFY_API_TOKEN=
BROWSERLESS_API_KEY=

# Optional local context sources. Leave blank unless you intentionally enable
# private local folder lookup for your own machine. Do not commit real paths.
KEYSTONE_NEUROINFORMATICS_DIR=
KEYSTONE_ZOTERO_ACTIVE_DIR=
KEYSTONE_ZOTERO_APP_SUPPORT_DIR=
KEYSTONE_ZOTERO_REFERENCE_ARCHIVE_DIR=
KEYSTONE_ZOTERO_IMPORT_CACHE=
KEYSTONE_LOCAL_CONTEXT_SOURCES_JSON=
KEYSTONE_LOCAL_CONTEXT_SOURCES=

# 9. Optional external table mirrors and CRM context imports.
# Live Airtable and Google Sheets mirroring are placeholders and require explicit live flags.
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_SHEETS_SPREADSHEET_ID=
